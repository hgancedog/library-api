# --- Python environment ---
# Ignore the virtual environment folder
.venv/
env/
venv/
ENV/

# --- Python build and cache ---
# Recursive pattern to ignore all __pycache__ folders
**/__pycache__/
# Editable install metadata (generated by pip install -e)
*.egg-info/
# Compiled bytecode
*.py[cod]
# Optimized files
*.pyo
# Pyright cache
.pyright_cache/

# --- Visual Studio Code ---
# Ignore local workspace settings
.vscode/

# --- Environment Variables (Security) ---
# NEVER commit these files as they contain secrets
.env
.env.local

# --- Database ---
# Ignore local SQLite databases
*.db
*.sqlite3
# Local Pi runtime state
.atl/

# Personal learning docs
project_docs/git-commands.md
project_docs/python-theory.md
